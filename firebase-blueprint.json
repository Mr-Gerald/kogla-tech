{
  "entities": {
    "User": {
      "title": "User Profile Document",
      "description": "Represents the sovereign profile of an authenticated developer or admin on Kogla Tech.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier matching the Firebase Auth UID" },
        "name": { "type": "string", "description": "Human-readable full name" },
        "email": { "type": "string", "description": "Corporate or validated email address" },
        "role": { "type": "string", "enum": ["user", "admin", "affiliate"], "description": "System role restricting access nodes" },
        "xp": { "type": "integer", "description": "Accumulated Academy Study XP" },
        "completedRooms": { "type": "array", "description": "Array of room slugs completed by the developer" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of profile creation" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of last profile update" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Inquiry": {
      "title": "Admissions or Solutions Intake Inquiry",
      "description": "Represents a parsed client inquiry, corporate solutions brief, or academic cohort request.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique inquiry token identifier" },
        "type": { "type": "string", "enum": ["enrollment", "solution_inquiry", "contact"], "description": "Origin of processing gateway" },
        "title": { "type": "string", "description": "Target course path or development tier requested" },
        "senderName": { "type": "string", "description": "Full name of contact entity" },
        "senderEmail": { "type": "string", "description": "Validated return email address" },
        "description": { "type": "string", "description": "Core message text or curriculum ambitions statement" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Dynamic intake timestamp" },
        "status": { "type": "string", "enum": ["Unread", "In Progress", "Contacted", "Archived"], "description": "SLA queue processing status" },
        "userId": { "type": "string", "description": "Link to the logged-in user if submitted in profile state" }
      },
      "required": ["id", "type", "title", "senderName", "senderEmail", "description", "timestamp", "status"]
    },
    "Notification": {
      "title": "User Notification Record",
      "description": "Targeted notification alerts, credentials dispatches, and academic queue status updates.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique notification alert ID" },
        "userId": { "type": "string", "description": "Target developer UID" },
        "title": { "type": "string", "description": "Notification bold header" },
        "body": { "type": "string", "description": "Analytical notification body content" },
        "read": { "type": "boolean", "description": "Status indicating user interaction click State" },
        "timestamp": { "type": "string", "format": "date-time", "description": "Timestamp when alert launched" }
      },
      "required": ["id", "userId", "title", "body", "read", "timestamp"]
    },
    "Review": {
      "title": "User Review and Community Reply",
      "description": "Represents interactive course, service, or platform reviews and nested community discussion replies.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique review document identifier" },
        "userId": { "type": "string", "description": "UID of author user" },
        "userName": { "type": "string", "description": "Author display name" },
        "userAvatar": { "type": "string", "description": "Author avatar photo URL" },
        "userRole": { "type": "string", "description": "Author role badge (e.g. Student, Admin)" },
        "rating": { "type": "integer", "description": "Star rating out of 5 (1-5)" },
        "title": { "type": "string", "description": "Review summary title" },
        "content": { "type": "string", "description": "Body content of the review or reply comment" },
        "targetType": { "type": "string", "description": "Context area (e.g. platform, course, service)" },
        "targetId": { "type": "string", "description": "Target ID associated with review" },
        "parentId": { "type": "string", "description": "Parent review ID if this document is a reply" },
        "likedBy": { "type": "array", "description": "List of user UIDs who liked this review" },
        "likeCount": { "type": "integer", "description": "Total count of likes" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Creation ISO timestamp" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Last update ISO timestamp" }
      },
      "required": ["id", "userId", "userName", "content", "targetType", "likedBy", "likeCount", "createdAt"]
    },
    "Affiliate": {
      "title": "Affiliate and Creator Partner Profile",
      "description": "Represents a brand ambassador and creator partner with assigned promo code and commission tracking.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Partner unique ID matching user UID or generated token" },
        "code": { "type": "string", "description": "Uppercase promo code identifier" },
        "name": { "type": "string", "description": "Full legal name of ambassador" },
        "email": { "type": "string", "description": "Official email address" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "instagramHandle": { "type": "string", "description": "Primary social media handle" },
        "tier": { "type": "integer", "enum": [1, 2], "description": "Active commission tier (1=6%, 2=10%)" },
        "baseRate": { "type": "integer", "description": "Base commission percentage" },
        "boostedRate": { "type": "integer", "description": "Elevated accelerator percentage" },
        "discountOffered": { "type": "integer", "description": "Student discount percentage" },
        "totalReferrals": { "type": "integer", "description": "Count of referred student inquiries" },
        "confirmedCount": { "type": "integer", "description": "Count of paid and confirmed student enrollments" },
        "totalEarned": { "type": "integer", "description": "Total commission earned in Naira" },
        "totalPaidOut": { "type": "integer", "description": "Total commission disbursed in Naira" },
        "pendingPayout": { "type": "integer", "description": "Pending commission payout balance in Naira" },
        "contractSigned": { "type": "boolean", "description": "Whether legal agreement has been accepted" },
        "contractSignedDate": { "type": "string", "format": "date-time", "description": "ISO timestamp of agreement execution" },
        "agreementDownloaded": { "type": "boolean", "description": "Whether ambassador has downloaded their agreement PDF" },
        "agreementDownloadedAt": { "type": "string", "format": "date-time", "description": "ISO timestamp when agreement PDF was downloaded" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Timestamp of partner registration" },
        "updatedAt": { "type": "string", "format": "date-time", "description": "Timestamp of latest partner update" }
      },
      "required": ["id", "code", "name", "email", "tier", "baseRate", "boostedRate", "contractSigned", "createdAt"]
    },
    "Referral": {
      "title": "Student Referral Lead and Payment Pipeline Record",
      "description": "Tracks incoming student enrollment attributed to an ambassador with commission calculations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique referral lead token ID" },
        "affiliateCode": { "type": "string", "description": "Referral promo code" },
        "studentName": { "type": "string", "description": "Full name of enrolling student" },
        "studentEmail": { "type": "string", "description": "Email address of enrolling student" },
        "studentPhone": { "type": "string", "description": "Phone number of enrolling student" },
        "courseTitle": { "type": "string", "description": "Selected course track" },
        "mode": { "type": "string", "enum": ["online", "physical"], "description": "Learning format" },
        "tuitionAmount": { "type": "integer", "description": "Original course tuition amount in Naira" },
        "discountApplied": { "type": "integer", "description": "Discount amount deducted in Naira" },
        "discountedAmount": { "type": "integer", "description": "Net payable tuition in Naira" },
        "commissionRate": { "type": "integer", "description": "Commission percentage (6 or 10)" },
        "commissionAmount": { "type": "integer", "description": "Calculated ambassador commission in Naira" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "paid_out"], "description": "Enrollment and commission settlement status" },
        "paymentProofNote": { "type": "string", "description": "Admin verification reference note" },
        "confirmedAt": { "type": "string", "format": "date-time", "description": "Payment confirmation timestamp" },
        "paidAt": { "type": "string", "format": "date-time", "description": "Payout settlement timestamp" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Lead submission timestamp" }
      },
      "required": ["id", "affiliateCode", "studentName", "studentEmail", "courseTitle", "mode", "tuitionAmount", "discountedAmount", "commissionAmount", "status", "createdAt"]
    },
    "Certificate": {
      "title": "Issued Student Certification Credential",
      "description": "Tamper-proof verifiable academic credential issued by Kogla Tech.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique certificate verification ID" },
        "studentName": { "type": "string", "description": "Certified graduate name" },
        "studentEmail": { "type": "string", "description": "Certified graduate email" },
        "courseTitle": { "type": "string", "description": "Completed engineering curriculum" },
        "mode": { "type": "string", "description": "Cohort delivery format" },
        "issueDate": { "type": "string", "description": "Formal issuance date" },
        "issuedBy": { "type": "string", "description": "Issuing institution" },
        "founderName": { "type": "string", "description": "Executive authority signatory" },
        "verified": { "type": "boolean", "description": "Cryptographic dual verification status" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Issuance record creation timestamp" }
      },
      "required": ["id", "studentName", "studentEmail", "courseTitle", "issueDate", "verified", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Airtight user-level profile documents isolating PII variables."
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Secure document collection containing solutions requests and admission statements."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications for alerts, credentials releases, and progress updates."
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Interactive public user reviews and threaded community replies."
    },
    "/affiliates/{affiliateCode}": {
      "schema": "Affiliate",
      "description": "Brand ambassador and creator partner registry with commission tracking."
    },
    "/referrals/{referralId}": {
      "schema": "Referral",
      "description": "Student referral leads, discount tracking, and commission payout pipeline."
    },
    "/certificates/{certificateId}": {
      "schema": "Certificate",
      "description": "Verifiable issued academic certificates and digital credentials."
    },
    "/config/{configId}": {
      "schema": "User",
      "description": "Global application dynamic configuration settings."
    }
  }
}
