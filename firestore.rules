rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Hardened Reusable Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }

    function isBootstrappedAdmin(emailStr) {
      return emailStr.lower() in [
        "emechebegerald@gmail.com", 
        "admin@kogla-tech.com", 
        "admin@koglatech.com", 
        "solutions@koglatech.com", 
        "solutions@kogla-tech.com"
      ];
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && isBootstrappedAdmin(request.auth.token.email)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData(request.auth.uid).role == "admin")
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- Validation Helper Blueprints ---
    function isValidUserShape(data) {
      return data.uid is string && data.uid.size() <= 128 &&
             data.name is string && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 128 &&
             data.role in ["user", "admin", "affiliate"] &&
             (!data.keys().hasAll(["completedRooms"]) || (data.completedRooms is list && data.completedRooms.size() <= 200)) &&
             (!data.keys().hasAll(["xp"]) || (data.xp is int && data.xp >= 0 && data.xp <= 1000000));
    }

    function isValidAffiliateShape(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.code is string && data.code.size() <= 64 &&
             data.name is string && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 128;
    }

    function isValidReferralShape(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.affiliateCode is string && data.affiliateCode.size() <= 64 &&
             data.studentName is string && data.studentName.size() <= 128 &&
             data.studentEmail is string && data.studentEmail.size() <= 128;
    }

    function isValidInquiryShape(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.type in ["enrollment", "solution_inquiry", "contact"] &&
             data.title is string && data.title.size() <= 256 &&
             data.senderName is string && data.senderName.size() <= 128 &&
             data.senderEmail is string && data.senderEmail.size() <= 128 &&
             data.description is string && data.description.size() <= 4096 &&
             data.status in ["Unread", "In Progress", "Contacted", "Archived"] &&
             (!data.keys().hasAll(["userId"]) || (data.userId is string && data.userId.size() <= 128));
    }

    function isValidNotificationShape(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.title is string && data.title.size() <= 256 &&
             data.body is string && data.body.size() <= 2048 &&
             data.read is bool;
    }

    function isValidReviewShape(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.userName is string && data.userName.size() <= 128 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 4096 &&
             data.targetType is string && data.targetType.size() <= 64 &&
             data.likedBy is list && data.likedBy.size() <= 1000 &&
             data.likeCount is int && data.likeCount >= 0 &&
             (!data.keys().hasAll(["rating"]) || (data.rating is int && data.rating >= 0 && data.rating <= 5)) &&
             (!data.keys().hasAll(["title"]) || (data.title is string && data.title.size() <= 256)) &&
             (!data.keys().hasAll(["parentId"]) || (data.parentId is string && data.parentId.size() <= 128)) &&
             (!data.keys().hasAll(["userAvatar"]) || (data.userAvatar is string && data.userAvatar.size() <= 512)) &&
             (!data.keys().hasAll(["userRole"]) || (data.userRole is string && data.userRole.size() <= 64)) &&
             (!data.keys().hasAll(["targetId"]) || (data.targetId is string && data.targetId.size() <= 128)) &&
             (!data.keys().hasAll(["createdAt"]) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!data.keys().hasAll(["updatedAt"]) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // --- System Resources Mappings ---

    // USERS COLLECTION
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && 
                    isOwner(userId) && 
                    isValidUserShape(incoming()) && 
                    (incoming().role in ["user", "affiliate"] || (incoming().role == "admin" && isBootstrappedAdmin(incoming().email))); // Prevent privilege escalation except for bootstrapped admin accounts
                    
      allow update: if (isOwner(userId) || isAdmin()) && 
                    isValidUserShape(incoming()) && (
                      isAdmin() || (
                        (incoming().role == existing().role || (incoming().role == "admin" && isBootstrappedAdmin(incoming().email))) && 
                        incoming().uid == existing().uid &&
                        incoming().email == existing().email
                      )
                    );
      allow delete: if isAdmin();
    }

    // AFFILIATES COLLECTION
    match /affiliates/{affiliateCode} {
      allow read, list: if true; // Publicly readable for promo code validation and partner portal
      allow create: if isValidAffiliateShape(incoming());
      allow update: if isValidAffiliateShape(incoming());
      allow delete: if isAdmin();
    }

    // REFERRALS COLLECTION
    match /referrals/{referralId} {
      allow read, list: if true; // Read for partner real-time dashboard and admin verification
      allow create: if isValidReferralShape(incoming());
      allow update, delete: if isAdmin();
    }

    // CERTIFICATES COLLECTION
    match /certificates/{certificateId} {
      allow read, list: if true; // Dual verification public registry
      allow write: if isAdmin();
    }

    // INQUIRIES COLLECTION
    match /inquiries/{inquiryId} {
      allow create: if isValidInquiryShape(incoming()) && (
                      !incoming().keys().hasAll(["userId"]) || (isSignedIn() && incoming().userId == request.auth.uid)
                    );
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || isSignedIn(); // Client secure queries
      allow update: if isAdmin() && isValidInquiryShape(incoming());
      allow delete: if isAdmin();
    }

    // NOTIFICATIONS COLLECTION
    match /notifications/{notificationId} {
      allow create: if (isAdmin() || (isSignedIn() && incoming().userId == request.auth.uid)) && isValidNotificationShape(incoming());
      allow get: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn(); // Client secure queries filtering by their own uid
      allow update: if isSignedIn() && (
                      (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['read']) && incoming().read is bool) || 
                      isAdmin()
                    ) && isValidNotificationShape(incoming());
      allow delete: if isAdmin();
    }

    // REVIEWS & REPLIES COLLECTION
    match /reviews/{reviewId} {
      allow read, list: if true; // Publicly readable reviews & community replies
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && isValidReviewShape(incoming());
      allow update: if isSignedIn() && isValidReviewShape(incoming()) && (
                      isAdmin() ||
                      (existing().userId == request.auth.uid && incoming().userId == existing().userId) ||
                      (incoming().diff(existing()).affectedKeys().hasOnly(['likedBy', 'likeCount', 'updatedAt']) && incoming().userId == existing().userId)
                    );
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // SYSTEM CONFIGURATION
    match /config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
